# Build products and machine-local runtime state are never part of a release.
/build/
/data/
/intranet-report/
__pycache__/
*.py[cod]
*.db
*.db-wal
*.db-shm
*.lock
/database/*
!/database/.gitkeep
/worker-output/*
!/worker-output/.gitkeep
/worker/workers_slots/*
!/worker/workers_slots/.gitkeep
/logs/**
!/logs/server/
!/logs/server/.gitkeep
!/logs/workers/
!/logs/workers/.gitkeep
!/logs/daily/
!/logs/daily/.gitkeep
